{
  "manifest_version": 3,
  "name": "PlantUML for GitHub",
  "version": "0.3.1",
  "description": "Renders plantuml code blocks directly on GitHub pages using the client-side TeaVM-compiled PlantUML engine.",
  "author": "Arnaud Roques",
  "homepage_url": "https://github.com/plantuml/plantuml",

#if FIREFOX
  "browser_specific_settings": {
    "gecko": {
      "id": "plantuml-for-github@plantuml.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
#endif

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "renderer.html",
        "renderer.js",
#if CHROME
        "vendor/plantuml.js",
#endif
#if FIREFOX
        "vendor/plantuml.0.js",
        "vendor/plantuml.1.js",
        "vendor/plantuml.2.js",
        "vendor/plantuml.3.js",
#endif
        "adaml.min.js",
        "archimate.min.js",
        "azure.min.js",
        "c4.min.js",
        "classy-c4.min.js",
        "classy.min.js",
        "cloudinsight.min.js",
        "cloudogu.min.js",
        "domainstory.min.js",
        "edgy.min.js",
        "eip.min.js",
        "elastic.min.js",
        "gcp.min.js",
        "k8s.min.js",
        "kubernetes.min.js",
        "osa2.min.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ],

  "permissions": ["clipboardWrite"]
}
